# Configuration for navet-calendar-proxy. Deployed to /etc/navet-ics/navet-ics.env.
# Every value has a working default; uncomment only what you want to change.

# --- Upstream --------------------------------------------------------------
# The public Convex deployment backing ifinavet.no, and the site it belongs to.
#CONVEX_URL=https://gallant-pheasant-518.convex.cloud
#SITE_URL=https://ifinavet.no

#HTTP_TIMEOUT=15
#HTTP_RETRIES=3
#HTTP_BACKOFF=1.5
#USER_AGENT=navet-calendar-proxy/1.0 (+https://github.com/vuhnger)
# Upstream calls in flight at once during a refresh. This is somebody else's
# Convex deployment; the enrichment below fans out, so stay a polite client.
#UPSTREAM_CONCURRENCY=4

# --- Enrichment ------------------------------------------------------------
# Each of these costs extra upstream calls per refresh and can be switched off
# on its own. A failure in any of them is logged and skipped, never fatal.
#FETCH_COMPANIES=true
#FETCH_JOB_LISTINGS=true
# Organizers are the expensive one: upstream has no bulk query, so this is one
# call per event, every refresh.
#FETCH_ORGANIZERS=true
#MAX_ORGANIZER_LOOKUPS=250
# Organizer e-mail addresses are personal data about Navet volunteers that
# upstream happens to expose. Off means /api never returns them; the calendar
# feeds never carry them either way.
#INCLUDE_ORGANIZER_EMAILS=false

# Company logos, emitted as RFC 7986 IMAGE and exposed as image_url in JSON.
#EVENT_IMAGES=true
# Formats worth publishing. SVG is deliberately absent: several clients (and
# Peoply's importer) will not render it, and a link they cannot draw is worse
# than no image. A logo outside this list is reported as absent.
#IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Refresh ---------------------------------------------------------------
# How often to re-fetch upstream, in seconds (300..86400). Default: hourly.
#REFRESH_INTERVAL_SECONDS=3600
# Random extra delay so restarts do not synchronise into a thundering herd.
#REFRESH_JITTER_SECONDS=120

# --- Feed contents ---------------------------------------------------------
#CALENDAR_NAME=Navet - arrangementer
#CALENDAR_DESCRIPTION=Arrangementer fra Navet, linjeforeningen for informatikk ved UiO.
#REGISTRATION_CALENDAR_NAME=Navet - påmeldingsåpninger
#REGISTRATION_CALENDAR_DESCRIPTION=Når påmeldingen åpner for Navets arrangementer.
#JOBS_CALENDAR_NAME=Navet - søknadsfrister
#JOBS_CALENDAR_DESCRIPTION=Søknadsfrister for stillinger utlyst hos Navet.
#CALENDAR_TIMEZONE=Europe/Oslo
# Upstream stores no end time, so every event gets this duration.
#DEFAULT_DURATION_MINUTES=120
# Registration openings and application deadlines are instants rather than
# blocks, but need a non-zero length or some clients render nothing.
#REMINDER_DURATION_MINUTES=30
# VALARM lead time in the registration and job feeds. 0 emits no alarm.
#REMINDER_ALARM_MINUTES=15
# How far back to keep events. Keeping some history means the feed is never
# empty, which matters: an empty calendar makes subscribers archive everything.
#PAST_DAYS=180
# Same, for expired job listings.
#JOBS_PAST_DAYS=180
# Hard ceiling on feed size. Peoply rejects a sync above 500 events.
#MAX_EVENTS=400
#MAX_JOBS=400
# Smallest fraction of the previous feed a refresh may shrink to before it is
# treated as upstream breakage and rejected. Guards against a "successful" but
# empty or truncated upstream response, which would make subscribers archive
# every imported event. Set to 0 to disable.
#MIN_EVENT_RATIO=0.5

# --- Serving ---------------------------------------------------------------
#STATE_DIR=/var/lib/navet-ics
# Age after which the feed is reported stale by /readyz (still served).
#STALE_AFTER_SECONDS=21600
#LOG_LEVEL=INFO

# --- JSON API paging -------------------------------------------------------
# Page size when a request does not ask for one, and the ceiling a request may
# ask for. The cap is what keeps a list endpoint from being an unbounded query.
#DEFAULT_PAGE_SIZE=50
#MAX_PAGE_SIZE=200
